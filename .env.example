# Cloudflare R2 (optional). When set, profiles are stored in R2 instead of data/profiles,
# venue signage profiles in signage/venues/, and the venue + client logo library APIs are enabled.
#
# Create an R2 bucket + API token (Object Read & Write) in the Cloudflare dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
